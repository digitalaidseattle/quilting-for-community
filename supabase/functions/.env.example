# Copy to supabase/functions/.env for local development (that file is gitignored).
# Deployed projects set these with `supabase secrets set` instead.

# Stripe secret key (test mode: sk_test_...)
STRIPE_SECRET_KEY=
# Signing secret for the stripe-webhook endpoint (whsec_...). Locally this is
# printed by `stripe listen --forward-to localhost:54321/functions/v1/stripe-webhook`.
STRIPE_WEBHOOK_SECRET=
# Comma-separated URL prefixes Stripe Checkout may return people to.
ALLOWED_RETURN_URLS=http://localhost:3000/
